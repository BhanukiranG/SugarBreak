rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }
    function isAdmin() {
      return request.auth != null
        && request.auth.token.get('admin', false) == true
        && request.auth.token.get('email_verified', false) == true
        && request.auth.token.get('email', '') == 'bhanukiran5102@gmail.com';
    }
    function validBehavior(value) {
      return value in ['CONTINUE', 'ADD_RECOVERY_DAY', 'RESET_STREAK'];
    }
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId);
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'displayNameUpdatedAt', 'challengeBehavior', 'challengeBehaviorUpdatedAt', 'updatedAt'
        ])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 100
        && validBehavior(request.resource.data.challengeBehavior)
        && request.resource.data.displayNameUpdatedAt is number
        && request.resource.data.challengeBehaviorUpdatedAt is number
        && request.resource.data.updatedAt is number;
      match /challenges/{challengeId} {
        allow read: if isAdmin();
        allow update: if isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'targetSuccessfulDays', 'behavior', 'status', 'recoveryDays', 'updatedAt'
          ])
          && request.resource.data.targetSuccessfulDays is int
          && request.resource.data.targetSuccessfulDays > 0
          && request.resource.data.targetSuccessfulDays <= 3650
          && request.resource.data.recoveryDays is int
          && request.resource.data.recoveryDays >= 0
          && validBehavior(request.resource.data.behavior)
          && request.resource.data.status in ['ACTIVE', 'COMPLETED', 'PAUSED', 'CANCELLED']
          && request.resource.data.updatedAt is string;
      }
      match /checkIns/{checkInId} {
        allow read: if isAdmin();
        allow update: if isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reason', 'updatedAt'])
          && request.resource.data.status in ['SUCCESS', 'SLIP', 'SKIPPED', 'PENDING']
          && (request.resource.data.get('reason', null) == null
            || (request.resource.data.status == 'SLIP'
              && request.resource.data.reason in ['SWEET', 'DESSERT', 'SUGARY_DRINK', 'TEA_OR_COFFEE', 'OTHER']))
          && request.resource.data.updatedAt is string;
      }
      match /syncState/progress {
        allow read: if isAdmin();
        allow create, update: if isAdmin()
          && request.resource.data.keys().hasOnly(['revision'])
          && request.resource.data.revision == request.time;
      }
      match /{document=**} {
        allow read, write: if isOwner(userId);
      }
    }
    match /adminEdits/{editId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.actorEmail == request.auth.token.email
        && request.resource.data.createdAt == request.time
        && request.resource.data.targetPath is string
        && request.resource.data.before is map
        && request.resource.data.after is map
        && request.resource.data.note is string
        && request.resource.data.note.size() > 0
        && request.resource.data.note.size() <= 500;
    }
  }
}
